# PulseGuard Environment Configuration Example
# Copy this file to .env for local Docker Compose or standalone execution

# Application Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pulseguard
DB_USER=pulseguard_user
DB_PASSWORD=pulseguard_secret_change_in_production

# Automated Background Monitoring Scheduler
PULSEGUARD_SCHEDULER_ENABLED=true
PULSEGUARD_SCHEDULER_POLL_INTERVAL_MS=5000
PULSEGUARD_SCHEDULER_INITIAL_DELAY_MS=2000
PULSEGUARD_MAX_CONCURRENT_CHECKS=10
PULSEGUARD_SCHEDULER_QUEUE_CAPACITY=100
PULSEGUARD_SCHEDULER_TERMINATION_TIMEOUT_SECONDS=30

# Incident Detection & Recovery Configuration
PULSEGUARD_INCIDENT_FAILURES_THRESHOLD=3
PULSEGUARD_INCIDENT_SUCCESSES_THRESHOLD=1
PULSEGUARD_INCIDENT_INITIAL_SEVERITY=CRITICAL

# Statistical Anomaly Detection & Adaptive Alerting
PULSEGUARD_ANOMALY_ENABLED=true
PULSEGUARD_ANOMALY_OBSERVATION_WINDOW=PT15M
PULSEGUARD_ANOMALY_BASELINE_WINDOW=PT1H
PULSEGUARD_ANOMALY_MIN_SAMPLES=10
PULSEGUARD_ANOMALY_LATENCY_MULTIPLIER=2.0
PULSEGUARD_ANOMALY_MIN_LATENCY_MS=200
PULSEGUARD_ANOMALY_LATENCY_THRESHOLD_MS=2000
PULSEGUARD_ANOMALY_CRITICAL_LATENCY_MULTIPLIER=3.5
PULSEGUARD_ANOMALY_CRITICAL_LATENCY_THRESHOLD_MS=5000
PULSEGUARD_ANOMALY_ERROR_RATE_THRESHOLD=0.25
PULSEGUARD_ANOMALY_CRITICAL_ERROR_RATE_THRESHOLD=0.60
PULSEGUARD_ANOMALY_CONSECUTIVE_BREACHES=3
PULSEGUARD_ANOMALY_CONSECUTIVE_SUCCESSES=3
PULSEGUARD_ANOMALY_ESCALATION_BREACHES=5
PULSEGUARD_ANOMALY_MAX_HISTORY_CHECKS=500

# Notification Dispatcher & Outbox Engine
PULSEGUARD_NOTIFICATIONS_DISPATCHER_ENABLED=true
PULSEGUARD_NOTIFICATIONS_POLL_INTERVAL_MS=2000
PULSEGUARD_NOTIFICATIONS_INITIAL_DELAY_MS=3000
PULSEGUARD_NOTIFICATIONS_BATCH_SIZE=20
PULSEGUARD_NOTIFICATIONS_MAX_CONCURRENT=4
PULSEGUARD_NOTIFICATIONS_QUEUE_CAPACITY=4
PULSEGUARD_NOTIFICATIONS_LEASE_DURATION=PT2M
PULSEGUARD_NOTIFICATIONS_TERMINATION_TIMEOUT_SECONDS=30
PULSEGUARD_NOTIFICATIONS_MAX_ATTEMPTS=6
PULSEGUARD_NOTIFICATIONS_INITIAL_BACKOFF=PT5S
PULSEGUARD_NOTIFICATIONS_MAX_BACKOFF=PT10M
PULSEGUARD_NOTIFICATIONS_JITTER=0.2
PULSEGUARD_NOTIFICATIONS_RATE_LIMIT_PER_MINUTE=120
PULSEGUARD_NOTIFICATIONS_OCCURRENCE_NOTIFY_EVERY=10
PULSEGUARD_NOTIFICATIONS_OCCURRENCE_MIN_INTERVAL=PT10M

# Notification Channel Destinations (Placeholders - never commit real webhook URLs)
PULSEGUARD_NOTIFICATIONS_ALLOW_UNSAFE=false
PULSEGUARD_NOTIFICATIONS_ALLOWED_HOSTS=
PULSEGUARD_NOTIFICATIONS_WEBHOOK_ENABLED=false
PULSEGUARD_NOTIFICATIONS_WEBHOOK_URL=
PULSEGUARD_NOTIFICATIONS_WEBHOOK_SECRET=
PULSEGUARD_NOTIFICATIONS_SLACK_ENABLED=false
PULSEGUARD_NOTIFICATIONS_SLACK_URL=

