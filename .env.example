# PulseGuard Environment Configuration Example
# Copy this file to .env for local Docker Compose or standalone execution

# Application Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pulseguard
DB_USER=pulseguard_user
DB_PASSWORD=pulseguard_secret_change_in_production

# Automated Background Monitoring Scheduler
PULSEGUARD_SCHEDULER_ENABLED=true
PULSEGUARD_SCHEDULER_POLL_INTERVAL_MS=5000
PULSEGUARD_SCHEDULER_INITIAL_DELAY_MS=2000
PULSEGUARD_MAX_CONCURRENT_CHECKS=10
PULSEGUARD_SCHEDULER_QUEUE_CAPACITY=100
PULSEGUARD_SCHEDULER_TERMINATION_TIMEOUT_SECONDS=30

# Incident Detection & Recovery Configuration
PULSEGUARD_INCIDENT_FAILURES_THRESHOLD=3
PULSEGUARD_INCIDENT_SUCCESSES_THRESHOLD=1
PULSEGUARD_INCIDENT_INITIAL_SEVERITY=CRITICAL

